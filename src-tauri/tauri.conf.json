{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tokentrace",
  "version": "0.1.0",
  "identifier": "com.tokentrace.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Token Trace",
        "width": 382,
        "height": 68,
        "minWidth": 382,
        "minHeight": 68,
        "maxWidth": 430,
        "maxHeight": 468,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "dataDirectory": "tokentrace-webview"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
